{
  "manifest_version": 3,
  "name": "NetScope – AI API Copilot: Network Logs, cURL Runner & Flows",
  "short_name": "NetScope",
  "version": "2.2.0",
  "minimum_chrome_version": "116",
  "description": "Chat with Kimi or Muse about any page's API traffic, send requests from cURL like Postman, and automate multi-step API flows on a schedule.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NetScope (Alt+Shift+N)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open or hide NetScope on this page"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "unlimitedStorage",
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["net-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://muse.ai/*"],
      "js": ["muse-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["app.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "homepage_url": "https://github.com/taishi55/NetScope"
}
